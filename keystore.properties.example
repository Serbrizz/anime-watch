# Keystore condiviso con cui si firmano TUTTI gli APK di AnimeWatch (debug e release, su ogni PC).
# Copia questo file in keystore.properties (ignorato da git) e indica il keystore che ti passa chi
# gestisce le release (non quello di debug del tuo PC): la build controlla che il suo SHA-1 sia
# appSigningSha1 di gradle.properties e altrimenti si ferma.
# Nei percorsi usa / al posto di \ (nei .properties \ è un carattere di escape);
# un percorso relativo parte dalla radice del progetto.
storeFile=C:/percorso/del/keystore/animewatch.keystore
storePassword=android
keyAlias=androiddebugkey
keyPassword=android
